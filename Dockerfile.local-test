# Local-only Dockerfile for building this fork branch and running it alongside
# production for testing. Not part of the official project build.

FROM node:20-bullseye AS frontend
WORKDIR /src
COPY package.json yarn.lock .yarnrc ./
RUN yarn install --frozen-lockfile --network-timeout 120000
COPY frontend ./frontend
COPY tsconfig.json ./
RUN yarn run build --env production

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS backend
WORKDIR /src
COPY src ./src
COPY Logo ./Logo
COPY --from=frontend /src/_output/UI ./_output/UI
RUN dotnet msbuild -restore src/Whisparr.sln \
    -p:SelfContained=True \
    -p:Configuration=Release \
    -p:Platform=Posix \
    -p:RuntimeIdentifiers=linux-x64 \
    -p:NuGetAudit=false \
    -p:EnableAnalyzers=false \
    -t:PublishAllRids

RUN mkdir -p /app/bin \
    && cp -r _output/net8.0/linux-x64/publish/* /app/bin/ \
    && cp -r _output/UI /app/bin/UI \
    && rm -f /app/bin/Whisparr.Windows.* /app/bin/ServiceUninstall.* /app/bin/ServiceInstall.*

# DeploymentInfoProvider only reads package_info when the running assembly's directory is
# literally named "bin" (matching the official Docker image's layout) - this marks the app as a
# Docker deployment, which disables the built-in self-updater UI/checks entirely. Without this,
# a locally-built image defaults to UpdateMechanism.BuiltIn and shows update prompts against the
# official upstream project's releases, which don't apply to this fork.
RUN printf 'UpdateMethod=Docker\nBranch=eros\n' > /app/package_info

FROM mcr.microsoft.com/dotnet/runtime-deps:8.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

# Match production's PUID/PGID (1000:1000) so files written to the shared
# /config, /data/downloads, /data/media volumes keep consistent ownership.
RUN groupadd -g 1000 whisparr \
    && useradd -u 1000 -g 1000 -d /config -s /usr/sbin/nologin whisparr

COPY --from=backend /app /app
RUN chmod +x /app/bin/Whisparr && chown -R whisparr:whisparr /app

USER whisparr

EXPOSE 6969
ENTRYPOINT ["/app/bin/Whisparr", "-nobrowser", "-data=/config"]
